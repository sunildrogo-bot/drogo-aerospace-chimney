[Unit]
Description=Chimney web service and upload worker
After=network.target

[Service]
User=deploy
Group=www-data
WorkingDirectory=/home/deploy/chimney-app
EnvironmentFile=/home/deploy/chimney-app/.env
Environment=CHIMNEY_BIND=unix:/home/deploy/chimney-app/chimney.sock
ExecStart=/home/deploy/chimney-app/venv/bin/python -u chimney_process_manager.py
Restart=always

[Install]
WantedBy=multi-user.target
